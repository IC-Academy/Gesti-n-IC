# Portal de Solicitudes y Proyectos BI - variables de entorno del frontend
# Copia este archivo a ".env" (para desarrollo local) y ajusta lo que necesites.
# Todas las URLs son las de PRODUCCION reales de n8n (jmejiaromero.app.n8n.cloud).
# No existe ningun backend propio: la app llama estos webhooks directamente desde el navegador.

# PBI-01 Registrar Solicitud (PRIVADO, requiere x-api-key)
VITE_PBI01_URL=https://jmejiaromero.app.n8n.cloud/webhook/b1e1e547-11d8-4c78-b3d4-03dd739c101d/pbi/solicitudes

# PBI-02 Consultar Solicitud (PUBLICO)
VITE_PBI02_URL=https://jmejiaromero.app.n8n.cloud/webhook/0bdaac18-2853-4006-920e-5f1ca4bec455/pbi/solicitudes/consultar

# PBI-03 Listar Solicitudes / Bandeja BI (PRIVADO, requiere x-api-key)
VITE_PBI03_URL=https://jmejiaromero.app.n8n.cloud/webhook/d6f72879-d965-4eb8-94d9-9613c41f68c6/pbi/solicitudes/listar

# PBI-04 Guardar Evaluacion BI (PRIVADO, requiere x-api-key)
VITE_PBI04_URL=https://jmejiaromero.app.n8n.cloud/webhook/b5297d27-cae5-4533-8767-a8cf7288b453/pbi/evaluaciones/guardar

# PBI-05 Enviar a Autorizacion / Microinforme (PRIVADO, requiere x-api-key)
VITE_PBI05_URL=https://jmejiaromero.app.n8n.cloud/webhook/80741b76-4e1c-443c-98b0-4eeb81746d88/pbi/autorizacion/enviar

# PBI-06 Consultar Aprobacion por token (PUBLICO, protegido por token de un solo uso)
VITE_PBI06_URL=https://jmejiaromero.app.n8n.cloud/webhook/9efa9ca9-7d8a-4dbb-925e-1a6e9ed08e98/pbi/aprobacion/consultar

# PBI-07 Registrar Decision de aprobador (PUBLICO, protegido por token de un solo uso)
VITE_PBI07_URL=https://jmejiaromero.app.n8n.cloud/webhook/1be6f16a-4715-40dd-8103-f53f8b551f16/pbi/aprobacion/decidir

# Clave x-api-key por defecto para los endpoints PRIVADOS (PBI-01, 03, 04, 05).
# Opcional: el usuario tambien puede pegarla/editarla desde la pantalla de Configuracion
# de la app (se guarda en localStorage y tiene prioridad sobre esta variable).
# Mientras PBI_API_KEY no este configurada del lado de n8n (Settings > Variables),
# los endpoints privados operan en modo "fail-open" y aceptan la llamada aunque
# esta clave este vacia o no coincida (ver README del backend, seccion de seguridad).
VITE_DEFAULT_API_KEY=

# Base path para GitHub Pages (build-time, no runtime). Ver README seccion "Publicar en GitHub Pages".
# Ejemplo para un repo llamado "portal-bi-frontend" publicado en un project site:
#   VITE_BASE_PATH=/portal-bi-frontend/
# Dejar vacio ("/") para desarrollo local o dominio propio.
VITE_BASE_PATH=/
