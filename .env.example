# Portal de Solicitudes y Proyectos BI - variables de entorno del frontend
# Copia este archivo a ".env" (para desarrollo local) y ajusta lo que necesites.
# Plantilla segura: no contiene endpoints, correos, tokens ni credenciales reales.
# Configura las URLs solo en el entorno de despliegue. Recuerda que cualquier
# variable VITE_* queda visible en el bundle del navegador.

# PBI-01 Registrar Solicitud (PRIVADO, requiere x-api-key)
VITE_PBI01_URL=

# PBI-02 Consultar Solicitud (PUBLICO)
VITE_PBI02_URL=

# PBI-03 Listar Solicitudes / Bandeja BI (PRIVADO, requiere x-api-key)
VITE_PBI03_URL=

# PBI-04 Guardar Evaluacion BI (PRIVADO, requiere x-api-key)
VITE_PBI04_URL=

# PBI-05 Enviar a Autorizacion / Microinforme (PRIVADO, requiere x-api-key)
VITE_PBI05_URL=

# PBI-06 Consultar Aprobacion por token (PUBLICO, protegido por token de un solo uso)
VITE_PBI06_URL=

# PBI-07 Registrar Decision de aprobador (PUBLICO, protegido por token de un solo uso)
VITE_PBI07_URL=

# Solo para pruebas locales controladas. NO usar como secreto en produccion:
# los valores VITE_* pueden inspeccionarse desde el navegador. Para produccion,
# usa identidad corporativa y autorizacion del lado servidor.
VITE_DEFAULT_API_KEY=

# Base path para GitHub Pages (build-time, no runtime). Ver README seccion "Publicar en GitHub Pages".
# Ejemplo para un repo llamado "portal-bi-frontend" publicado en un project site:
#   VITE_BASE_PATH=/portal-bi-frontend/
# Dejar vacio ("/") para desarrollo local o dominio propio.
VITE_BASE_PATH=/Gesti-n-IC/

# =============================================================================
# Modulo nuevo: Gestion de Proyectos (roles Usuario / Lider / Administrador,
# portal del solicitante, seguimiento, evidencias, aprobaciones, auditoria).
# =============================================================================
#
# Este modulo TODAVIA NO tiene un webhook de n8n en produccion (a diferencia de
# PBI-01..07 arriba). En esta primera version corre en MODO DEMO: los datos
# viven en localStorage del navegador (ver src/lib/demoStore.ts), con datos de
# ejemplo realistas (areas, usuarios, proyectos, solicitudes, evidencias).
#
# VITE_PROJECTS_REQUEST_URL es OPCIONAL y esta preparada para el futuro: si se
# define, cuando alguien registra una solicitud en el Portal del Solicitante
# nuevo (/#/publico/nueva-solicitud o /#/portal/nueva-solicitud), la app
# ademas intenta notificar ese webhook con el payload documentado en
# src/lib/projectsApi.ts (best effort: si falla o no esta configurada, la
# solicitud igual queda registrada localmente y la app sigue funcionando sin
# errores visibles para quien la esta llenando).
#
# Dejar vacio mientras no exista el webhook real:
VITE_PROJECTS_REQUEST_URL=
