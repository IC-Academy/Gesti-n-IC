# Copia este archivo como .env.local para configurar el "modo API".
#
# Si se deja vacío (o el archivo no existe), la aplicación opera en
# "modo demo": todos los datos viven en localStorage del navegador y
# ningún servicio externo es contactado.
#
# Para conectar el frontend a los webhooks de n8n, define la URL base
# del backend. NUNCA coloques aquí tokens, API keys ni secretos de
# Airtable: esas credenciales deben vivir únicamente del lado del
# servidor (n8n), nunca en el frontend.
VITE_API_BASE_URL=

# Fuerza el modo de operación sin depender de VITE_API_BASE_URL.
# Valores permitidos: "demo" | "api". Opcional.
VITE_APP_MODE=demo
